PORT=4100
# Local: a PostgreSQL URL. Production: Railway injects DATABASE_URL from the Postgres plugin.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret"
OTP_PEPPER="change-this-otp-pepper"
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_CARD_PER_HOUR=5
OTP_MAX_SENDS_PER_COURIER_PER_HOUR=20
FRONTEND_ORIGIN="http://localhost:5174,https://YOUR-APP.vercel.app"

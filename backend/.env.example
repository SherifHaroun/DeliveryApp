# Copy this file to backend/.env and replace the placeholders.
# Do not commit backend/.env.

PORT=4100

# Temporary local development only. Do not set this in production.
# memory = in-memory store, no PostgreSQL.
# database or unset = Prisma/PostgreSQL (normal default).
BACKEND_DATA_MODE=memory

# Development database (npm run setup, BACKEND_DATA_MODE=database). Not the test database.
# Not required when BACKEND_DATA_MODE=memory.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/YOUR_DEV_DATABASE?schema=public"

# Isolated test database (npm test). Database name must contain "test".
# Do not reuse DATABASE_URL. Backend tests ignore DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/delivery_test?schema=public"

# Local development secrets. Production/Railway requires JWT_SECRET.
JWT_SECRET="local-development-secret"

# Railway backend only. Never set these in Vercel/frontend.
# RESEND_API_KEY = re_... (sending key)
# RESEND_FROM_EMAIL must be onboarding@resend.dev in test mode.
# Do NOT put your Gmail here. Gmail is the customer/recipient address, not the sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_CARD_PER_HOUR=5
OTP_MAX_SENDS_PER_COURIER_PER_HOUR=20
FRONTEND_ORIGIN="http://localhost:5174,https://YOUR-APP.vercel.app"

# Production: Railway injects DATABASE_URL from the Postgres plugin. Do not hardcode it.
# Optional. Local-only credentials for backend/scripts/security-review-check.ts. Do not commit real values.
SECURITY_CHECK_API_URL="http://localhost:4100"
SECURITY_CHECK_EMAIL=
SECURITY_CHECK_PASSWORD=
SECURITY_CHECK_SECOND_EMAIL=
SECURITY_CHECK_SECOND_PASSWORD=
